# --- Développement local ---
# Port d'écoute (conteneur ET hôte)
PORT=25XXX
# Route racine de l'application, derrière le reverse proxy (mon-domaine.fr/tasks/)
# Vide en local ; /tasks en production (derrière le reverse proxy).
URL_PREFIX=
SECRET_KEY=change-me
# Base de données PostgreSQL (sur une autre machine) : la même que l'ancien site (tables users, tasks, tasks_groups, shared_groups)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# true uniquement si la base est vide (cree les tables ; exige le droit CREATE sur le schema public)
DB_AUTO_CREATE=false

# --- Auth (service séparé, paquet auth_client) ---
# false = pas d'authentification (dev local, utilisateur simulé DEV_USERNAME). true en production.
AUTH_ENABLED=false
DEV_USERNAME=dev
# Rôle Keycloak exigé pour utiliser l'application (remplace l'ancienne permission "tasks"). Vide = tout utilisateur connecté.
REQUIRED_ROLE=
# Auth, vu depuis le conteneur (réseau Docker "web")
AUTH_INTERNAL_URL=http://auth:25000/auth
# Auth, vu depuis le navigateur
AUTH_PUBLIC_URL=https://mon-domaine.fr/auth
# URL publique de l'application, route racine incluse, sans slash final (retour après déconnexion)
PUBLIC_URL=https://mon-domaine.fr/tasks
# Derrière un reverse proxy / HTTPS
BEHIND_PROXY=false
SESSION_COOKIE_SECURE=false
